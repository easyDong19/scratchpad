{
  "name": "scratchpad",
  "version": "1.3.0",
  "description": "C++ typing practice scratchpad",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Scratchpad --platform=darwin --arch=arm64 --out=dist --overwrite --icon=icon.icns --app-bundle-id=kr.easydong.scratchpad --app-category-type=public.app-category.developer-tools --ignore=\"^/dist($|/)\" --ignore=\"^/\\\\.git($|/)\"",
    "install:app": "rm -rf /Applications/Scratchpad.app && cp -R dist/Scratchpad-darwin-arm64/Scratchpad.app /Applications/"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^43.4.1"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0"
  }
}
